{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main",
    "kluctl"
  ],
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "configMigration": true,
  "helm-values": {
    "enabled": true,
    "managerFilePatterns": ["/(^|/|.*-)values\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.envrc/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+)(?: depName=(?<depName>[a-zA-Z0-9-\\/]+))?(?: versioning=(?<versioning>[a-z-]+))?\\s[A-Z]+_VERSION=(?<currentValue>.+)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/|.*-)chart\\.ya?ml$/"],
      "matchStrings": [
        "repo:\\s*oci://(?<depName>[^\\s\\n]+)\\s+chartVersion:\\s*[\"']?(?<currentValue>[^\"'\\s\\n]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/|.*-)chart\\.ya?ml$/"],
      "matchStrings": [
        "repo:\\s*(?<registryUrl>https?://[^\\s\\n]+)\\s+chartName:\\s*(?<depName>[^\\s\\n]+)\\s+chartVersion:\\s*[\"']?(?<currentValue>[^\"'\\s\\n]+)[\"']?"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)deployment\\.ya?ml$/"],
      "matchStrings": [
        "^      url: https://github.com/(?<depName>samber/awesome-prometheus-alerts)/raw/refs/tags/(?<currentValue>2026-07-26.1)/dist/rules/etcd/embedded-exporter.yml"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "datasourceTemplate": "github-tags"
    }
  ]
}
